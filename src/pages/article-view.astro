---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostReaderView from '../components/PostReaderView.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const post =
  posts.find((p) => p.id === 'architecting-zero-cloud-smb-storage-omv-zfs-nextcloud') ?? posts[0];
const prevPost =
  posts.find((p) => p.id === 'bypassing-android-audio-mixer-bit-perfect-usb-dac') ??
  posts[1] ??
  post;
const nextPost =
  posts.find((p) => p.id === 'why-i-migrated-il0g-from-hugo-to-astro-5-cloudflare-pages') ??
  posts[2] ??
  post;
---

<BaseLayout
  title={`${post.data.title} — il0g.com:~#`}
  description={post.data.description}
  currentPath="/posts"
>
  <PostReaderView post={post} prevPost={prevPost} nextPost={nextPost} />
</BaseLayout>
