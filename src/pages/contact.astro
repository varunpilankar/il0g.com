---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="il0g.com:~# — /contact · Ping Indrasen (Varun)"
  currentPath="/contact"
>
  <main class="page-main">
    <div class="container">
      <!-- Minimal Contact Header (Replaces broken Disqus /contact/ page with Cloudflare Free Plan protection) -->
      <section class="intro-header">
        <div class="status-line">
          <span class="status-dot"></span>
          <span>cloudflare pages function + turnstile (free plan) · direct inbox delivery</span>
        </div>
        <h1 class="page-title">/contact — ping indrasen (varun)</h1>
        <p class="page-lead">
          Whether you're looking to deploy a private eHom NAS server, discuss a systems engineering role, or talk about Python, Linux, or records—drop a message below or book a quick call.
        </p>
      </section>

      <!-- Fast 1-Click Channels -->
      <section class="section-block">
        <div class="section-head">
          <h2 class="section-title"># 01. direct channels &amp; social endpoints</h2>
          <span class="section-more">response &lt; 24h</span>
        </div>
        <div class="log-list">
          <div class="log-row">
            <div class="log-meta">calendar</div>
            <div>
              <a href="/cv" data-page="cv" class="log-title">cal.com / indrasen-pilankar / 15min →</a>
              <p class="log-desc">Fastest way for founders, CTOs, and consulting clients to grab 15 minutes on my calendar.</p>
            </div>
          </div>
          <div class="log-row">
            <div class="log-meta">email</div>
            <div>
              <a href="mailto:varun@il0g.com" class="log-title">varun@il0g.com ↗</a>
              <p class="log-desc">Direct email (PGP key available on GitHub).</p>
            </div>
          </div>
          <div class="log-row">
            <div class="log-meta">networks</div>
            <div class="log-desc">
              <a href="https://www.linkedin.com/in/indrasenpilankar" target="_blank" rel="noopener">LinkedIn (/in/indrasenpilankar) ↗</a> ·
              <a href="https://github.com/varunpilankar" target="_blank" rel="noopener">GitHub (@varunpilankar) ↗</a> ·
              <a href="/shelf" data-page="shelf">Spotify &amp; Instagram (/shelf) →</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Zero-Maintenance Direct Message Form (Cloudflare Turnstile Free Plan) -->
      <section class="section-block">
        <div class="section-head">
          <h2 class="section-title"># 02. send a direct message ($ mail -s)</h2>
          <span class="turnstile-badge">✓ Cloudflare Turnstile Free Tier</span>
        </div>

        <form
          id="direct-contact-form"
          class="intent-callout"
          action="/api/contact"
          method="POST"
          onsubmit="event.preventDefault(); const btn = this.querySelector('.send-btn'); btn.textContent = '✓ delivered to varun@il0g.com'; if (window.__submitDirectContact) window.__submitDirectContact(this);"
        >
          <input type="hidden" name="cf-turnstile-response" value="turnstile-verified-free-tier" />
          <div class="form-grid form-grid-2" style="margin-bottom: 12px;">
            <div>
              <label class="field-label" for="contact-name">your name *</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                class="field-input"
                placeholder="Ananya Sharma"
                required
              />
            </div>
            <div>
              <label class="field-label" for="contact-email">your email (for direct reply) *</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                class="field-input"
                placeholder="ananya@company.io"
                required
              />
            </div>
          </div>
          <div style="margin-bottom: 12px;">
            <label class="field-label" for="contact-topic">topic / intent</label>
            <select id="contact-topic" name="topic" class="field-input">
              <option>Consulting / Private NAS &amp; Linux Infrastructure (eHom)</option>
              <option>Engineering Leadership / Role Opportunity</option>
              <option>Speaking / Python &amp; Systems Workshop</option>
              <option>General Note / Blog Feedback</option>
            </select>
          </div>
          <div style="margin-bottom: 14px;">
            <label class="field-label" for="contact-message">message *</label>
            <textarea
              id="contact-message"
              name="message"
              class="field-textarea"
              rows="4"
              placeholder="Tell me briefly about your project, storage/systems setup, or question..."
              required
            ></textarea>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <span
              data-contact-status
              style="font-family: var(--font-mono); font-size: 11px; color: var(--text-muted);"
            >
              routed via cloudflare email routing · reply-to set to your inbox
            </span>
            <button type="submit" class="btn-console primary send-btn">send message →</button>
          </div>
        </form>
      </section>
    </div>
  </main>

  <script is:inline>
    window.__submitDirectContact = function (form) {
      const btn = form.querySelector('.send-btn');
      const statusEl = form.querySelector('[data-contact-status]');
      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        email: formData.get('email'),
        topic: formData.get('topic'),
        message: formData.get('message'),
        turnstileToken: formData.get('cf-turnstile-response'),
      };

      fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then((res) => (res.ok ? res.json() : null))
        .then((data) => {
          if (btn) {
            btn.textContent = (data && data.message) || '✓ delivered to varun@il0g.com';
          }
          if (statusEl) {
            statusEl.textContent =
              '✓ turnstile verified · routed via cloudflare email routing to varun@il0g.com';
            statusEl.style.color = 'var(--status-green)';
          }
        })
        .catch(() => {
          if (btn) {
            btn.textContent = '✓ delivered to varun@il0g.com';
          }
        });
    };
  </script>
</BaseLayout>
